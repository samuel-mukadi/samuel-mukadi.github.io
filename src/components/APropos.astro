---
// « Qui suis-je ? » : mon histoire, le grand carré avec ma photo, mon équipe
// et ma méthode de travail.
const etapes = [
  {
    titre: 'Comprendre',
    texte: "Je pose les bonnes questions et j'écris la vision du produit avec des mots simples.",
  },
  {
    titre: 'Planifier',
    texte: 'Feuille de route, décisions écrites, une tâche à la fois.',
  },
  {
    titre: 'Construire',
    texte: 'Claude, mon développeur IA, construit sur mes instructions.',
  },
  {
    titre: 'Vérifier',
    texte: 'Codex contrôle chaque travail. Je valide moi-même avant de passer à la suite.',
  },
];
---

<section id="qui-suis-je" class="section section--sable" aria-labelledby="titre-qui-suis-je">
  <div class="conteneur">
    <div class="grille">
      <div class="texte surgit">
        <p class="sur-titre">Qui suis-je ?</p>
        <h2 id="titre-qui-suis-je" class="section-titre">
          Des idées de chez nous, <span class="italique accent">transformées en produits</span>
        </h2>
        <p>
          Je suis Développeur, orchestrateur des agents IA et chef de projet digital. Je pars d'un vrai problème que l'on vit en
          RDC et je le transforme en produit numérique : l'idée, les écrans, les
          règles et le plan de travail.
        </p>
        <p>
          Je ne code pas seul. J'orchestre une équipe d'IA : je décide par des bons prompt et transmet mon intention à, Claude
         qui construit,  et Codex vérifie. Chaque étape passe par moi avant d'avancer.
        </p>
        <p>
          Je maîtrise HTML, CSS et JavaScript. J'apprends maintenant Node.js, React,
          TypeScript, Astro et les autres outils de l'écosystème JavaScript, ainsi que Python,
          pour construire et vérifier encore mieux ce que l'on fait.
        </p>
      </div>

      <div class="visuel surgit s1">
        <!-- Le grand carré avec ma photo (800 × 800).
             Pour la changer : node outils/preparer-photo.mjs <ma photo> public/images/samuel 800 800 -->
        <div class="carre carre--photo">
          <picture>
            <source srcset="/images/samuel.webp" type="image/webp" />
            <img
              src="/images/samuel.jpg"
              alt="Samuel Mukadi"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="lieu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
              <circle cx="12" cy="9.5" r="2.5" />
            </svg>
            RDC
          </span>
        </div>

        <figure class="equipe">
          <figcaption class="equipe-titre">Mon équipe</figcaption>
          <ol>
            <li>
              <span class="pastille pastille--rouge" aria-hidden="true">SM</span>
              <span><strong>Samuel</strong> Décide et valide</span>
            </li>
            <li>
              <span class="pastille" aria-hidden="true">C</span>
              <span><strong>Claude</strong> Construit</span>
            </li>
            <li>
              <span class="pastille" aria-hidden="true">Cx</span>
              <span><strong>Codex</strong> Vérifie</span>
            </li>
          </ol>
        </figure>
      </div>
    </div>

    <h3 class="methode-titre surgit">Ma <span class="italique accent">méthode</span></h3>
    <ol class="etapes">
      {etapes.map((etape, i) => (
        <li class={`surgit s${i % 4}`}>
          <span class="numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <strong>{etape.titre}</strong>
          <p>{etape.texte}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .grille {
    display: grid;
    gap: 56px;
  }

  @media (min-width: 900px) {
    .grille {
      grid-template-columns: 1.15fr 1fr;
      gap: 80px;
      align-items: center;
    }
  }

  .texte p {
    max-width: 560px;
    font-size: 1.05rem;
  }

  /* Le grand carré en dégradé */

  .visuel {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }

  .carre {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--rayon-grand);
    background:
      radial-gradient(circle at 82% 14%, rgba(245, 184, 65, 0.55) 0, transparent 42%),
      linear-gradient(150deg, #E53935 0%, var(--rouge-fonce) 32%, var(--bordeaux) 68%, var(--nuit-2) 100%);
    box-shadow: 0 40px 70px -24px rgba(74, 15, 20, 0.6);
    transform: rotate(2deg);
  }

  /* Deux grands cercles fins, pour donner du relief */
  .carre::before,
  .carre::after {
    content: "";
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
  }

  .carre::before {
    width: 78%;
    aspect-ratio: 1;
  }

  .carre::after {
    width: 112%;
    aspect-ratio: 1;
  }

  /* Avec la photo : plus de cercles, la photo remplit tout le carré */
  .carre--photo::before,
  .carre--photo::after {
    display: none;
  }

  .carre img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lieu {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(18, 20, 28, 0.6);
    color: #fff;
    font-family: var(--police-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .lieu svg {
    width: 16px;
    height: 16px;
    color: var(--or);
  }

  /* Carte « Mon équipe », posée de travers sur le bas du carré */

  .equipe {
    position: relative;
    z-index: 2;
    margin: -64px 16px 0;
    padding: 18px 20px;
    border-radius: var(--rayon);
    background: var(--nuit);
    color: var(--texte-clair);
    box-shadow: 0 24px 48px -12px rgba(18, 20, 28, 0.55);
    transform: rotate(-2deg);
  }

  @media (min-width: 900px) {
    .equipe {
      position: absolute;
      left: -64px;
      bottom: -44px;
      width: 260px;
      margin: 0;
    }
  }

  .equipe-titre {
    margin-bottom: 12px;
    color: var(--or);
    font-family: var(--police-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .equipe ol {
    position: relative;
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Le trait qui relie les trois membres */
  .equipe ol::before {
    content: "";
    position: absolute;
    top: 19px;
    bottom: 19px;
    left: 18px;
    border-left: 2px dashed rgba(245, 184, 65, 0.4);
  }

  .equipe li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .equipe li strong {
    display: block;
    color: #fff;
  }

  .equipe li span:last-child {
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .pastille {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 2px solid var(--or);
    border-radius: 50%;
    background: var(--nuit);
    color: var(--or);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .pastille--rouge {
    border-color: var(--rouge);
    background: var(--rouge);
    color: #fff;
  }

  /* Ma méthode : quatre cartes numérotées */

  .methode-titre {
    margin: 88px 0 20px;
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .methode-titre .italique {
    font-weight: 500;
  }

  .etapes {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 600px) {
    .etapes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .etapes {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .etapes li {
    display: flex;
    flex-direction: column;
    min-height: 190px;
    padding: 20px;
    border: 1px solid rgba(18, 20, 28, 0.08);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.6);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .etapes li:hover {
    border-color: var(--rouge-pale);
    box-shadow: var(--ombre);
  }

  .numero {
    margin-bottom: auto;
    padding-bottom: 20px;
    color: var(--rouge);
    font-family: var(--police-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .etapes strong {
    display: block;
    margin-bottom: 4px;
    color: var(--texte);
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .etapes p {
    margin: 0;
    line-height: 1.45;
  }
</style>
