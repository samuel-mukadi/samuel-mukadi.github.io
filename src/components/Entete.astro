---
// Barre du haut (fond nuit) : le rond « SM » et le nom, le menu au centre
// dans une pilule (un point rouge montre la section où l'on se trouve),
// et le bouton « Me contacter » à droite. Sur téléphone : le menu à trois traits.
const liens = [
  { href: '#projets', texte: 'Projets' },
  { href: '#qui-suis-je', texte: 'Qui suis-je ?' },
  { href: '#competences', texte: 'Compétences' },
  { href: '#avis', texte: 'Avis' },
  { href: '#contact', texte: 'Contact', telephone: true },
];
---

<header class="entete">
  <div class="conteneur ligne">
    <a class="marque" href="#accueil">
      <span class="rond" aria-hidden="true">
        <picture>
          <source srcset="/images/samuel-rond.webp" type="image/webp" />
          <img src="/images/samuel-rond.jpg" alt="" width="40" height="40" decoding="async" />
        </picture>
      </span>
      <span>Samuel Mukadi</span>
    </a>

    <button
      class="menu-bouton"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Ouvrir le menu"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="menu" class="menu" aria-label="Menu principal">
      <ul>
        {liens.map((lien) => (
          <li class={lien.telephone ? 'seulement-telephone' : ''}>
            <a href={lien.href} data-lien-section={lien.href.slice(1)}>{lien.texte}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="appel" href="#contact">
      Me contacter
      <span class="fleche" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
      </span>
    </a>
  </div>
</header>

<script>
  // Menu du téléphone : ouvrir, fermer, fermer après un choix ou avec Échap.
  const bouton = document.querySelector<HTMLButtonElement>('.menu-bouton');
  const menu = document.getElementById('menu');

  if (bouton && menu) {
    const fermer = () => {
      bouton.setAttribute('aria-expanded', 'false');
      bouton.setAttribute('aria-label', 'Ouvrir le menu');
      menu.classList.remove('ouvert');
    };

    const ouvrir = () => {
      bouton.setAttribute('aria-expanded', 'true');
      bouton.setAttribute('aria-label', 'Fermer le menu');
      menu.classList.add('ouvert');
    };

    bouton.addEventListener('click', () => {
      if (bouton.getAttribute('aria-expanded') === 'true') fermer();
      else ouvrir();
    });

    menu.addEventListener('click', (evenement) => {
      if (evenement.target instanceof HTMLAnchorElement) fermer();
    });

    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape') fermer();
    });
  }

  // Le point rouge suit la section que l'on est en train de lire.
  const liensSection = [...document.querySelectorAll<HTMLAnchorElement>('[data-lien-section]')];
  const sections = liensSection
    .map((lien) => document.getElementById(lien.dataset.lienSection!))
    .filter((s): s is HTMLElement => s !== null);

  if ('IntersectionObserver' in window && sections.length) {
    const marquer = (id: string | null) => {
      liensSection.forEach((lien) => {
        const actif = lien.dataset.lienSection === id;
        lien.classList.toggle('actif', actif);
        if (actif) lien.setAttribute('aria-current', 'true');
        else lien.removeAttribute('aria-current');
      });
    };

    const observateur = new IntersectionObserver(
      (entrees) => {
        for (const entree of entrees) {
          if (entree.isIntersecting) marquer(entree.target.id);
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observateur.observe(s));
  }
</script>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(18, 20, 28, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    min-height: var(--hauteur-entete);
  }

  .marque {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    color: #fff;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* Ma photo dans un rond, avec un anneau rouge */
  .rond {
    display: block;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    padding: 2px;
    border-radius: 50%;
    background: var(--rouge);
  }

  .rond img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .menu ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 999px;
    color: var(--texte-clair);
    font-weight: 500;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .menu a:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  /* La section en cours : texte blanc et point rouge */
  .menu a.actif {
    color: #fff;
  }

  .menu a.actif::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--rouge-doux);
  }

  /* Effet de clic : doré, comme les boutons */
  .menu a:active {
    background: var(--or);
    color: var(--nuit);
  }

  .appel {
    display: none;
  }

  .menu-bouton {
    display: none;
  }

  /* Ordinateur : la pilule au centre, « Me contacter » à droite */
  @media (min-width: 900px) {
    .ligne {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .menu ul {
      padding: 4px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.04);
    }

    .menu a {
      min-height: 44px;
      padding: 0 16px;
      font-size: 0.95rem;
    }

    .seulement-telephone {
      display: none;
    }

    .appel {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      justify-self: end;
      min-height: 46px;
      padding: 0 5px 0 18px;
      border-radius: 999px;
      background: #fff;
      color: var(--nuit);
      font-weight: 700;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
      transition: background-color 0.2s ease;
    }

    .appel:hover {
      background: var(--creme);
    }

    .appel:active {
      background: var(--or);
    }

    .fleche {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--rouge);
      color: #fff;
      transition: transform 0.3s var(--courbe);
    }

    .appel:hover .fleche {
      transform: rotate(45deg);
    }

    .fleche svg {
      width: 16px;
      height: 16px;
    }
  }

  /* Téléphone et tablette : le menu à trois traits */
  @media (max-width: 899px) {
    :global(.js) .menu-bouton {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 48px;
      height: 48px;
      padding: 13px 12px;
      border: 0;
      border-radius: 12px;
      background: none;
      cursor: pointer;
    }

    .menu-bouton span {
      display: block;
      height: 2px;
      border-radius: 2px;
      background: #fff;
    }

    .menu {
      width: 100%;
    }

    .menu ul {
      flex-wrap: wrap;
      padding-bottom: 8px;
    }

    :global(.js) .menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--nuit);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);
    }

    :global(.js) .menu.ouvert {
      display: block;
    }

    :global(.js) .menu ul {
      flex-direction: column;
      padding: 8px 16px 16px;
    }

    :global(.js) .menu a {
      padding: 14px 12px;
      border-radius: 12px;
    }
  }
</style>
