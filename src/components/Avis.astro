---
// « Ce qu'ils pensent de moi » : les avis et les étoiles.
//
// Deux sources d'avis (seulement des avis vrais, jamais inventés) :
// 1. Les avis EN DIRECT : la personne remplit le petit formulaire, son avis est rangé dans
//    la base Firestore (Firebase) EN ATTENTE (valide = false). Il ne s'affiche qu'une fois
//    que Samuel l'a validé dans la console Firebase (valide = true).
//    Réglages : src/data/firebase.js ; protections : firebase/firestore.rules.
// 2. Les avis reçus autrement (WhatsApp…), ajoutés à la main dans src/data/avis.js.
//
// Tant que Firebase n'est pas réglé, le bouton « Donner mon avis » ouvre WhatsApp.
// S'il y a plusieurs avis, on les montre un par un : on choisit avec les ronds (initiales).
import { avis } from '../data/avis.js';
import { contact } from '../data/contact.js';
import { firebase } from '../data/firebase.js';

const enDirect = Boolean(firebase.projet);
const total = avis.length;
const moyenne = total ? avis.reduce((somme, a) => somme + a.note, 0) / total : 0;
const moyenneTexte = moyenne.toFixed(1).replace('.', ',');
const etoilesMoyenne = Math.round(moyenne);

const message =
  "Bonjour Samuel, voici mon avis sur ton travail.\n" +
  'Ma note (de 1 à 5 étoiles) : \n' +
  'Mon avis : \n' +
  'Mon nom et ce que je fais : ';
const lienAvis = `${contact.whatsapp}?text=${encodeURIComponent(message)}`;

const initiales = (nom: string) =>
  nom
    .split(/\s+/)
    .filter(Boolean)
    .map((mot) => mot[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

const cinq = [1, 2, 3, 4, 5];
---

<section
  id="avis"
  class="section section--creme avis"
  aria-labelledby="titre-avis"
  data-avis-section
  data-projet={firebase.projet}
  data-cle={firebase.cle}
  data-fixes={JSON.stringify(avis)}
>
  <div class="conteneur grille">
    <div class="gauche surgit">
      <span class="guillemet" aria-hidden="true">“</span>
      <p class="sur-titre">Avis</p>
      <h2 id="titre-avis" class="section-titre">
        Ce qu'ils pensent <span class="italique accent">de moi</span>
      </h2>

      <p class="moyenne" data-moyenne hidden={total === 0}>
        <span class="etoiles" role="img" aria-label={`Note moyenne : ${moyenneTexte} sur 5`}>
          {cinq.map((n) => <span class={n <= etoilesMoyenne ? 'pleine' : 'vide'}>★</span>)}
        </span>
        <span><strong>{moyenneTexte} sur 5</strong>, d'après {total} avis</span>
      </p>

      <div class="visages" role="group" aria-label="Choisir l'avis à lire" data-visages hidden={total < 2}>
        {total > 1 && avis.map((a, i) => (
          <button type="button" class="visage" data-visage aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Lire l'avis de ${a.nom}`}>
            {initiales(a.nom)}
          </button>
        ))}
      </div>
    </div>

    <div class="droite surgit s1" data-avis-zone>
      {total > 0 ? (
        avis.map((a) => (
          <figure class="temoignage" data-avis>
            <div class="carte-avis">
              <span class="etoiles" role="img" aria-label={`${a.note} sur 5`}>
                {cinq.map((n) => <span class={n <= a.note ? 'pleine' : 'vide'}>★</span>)}
              </span>
              <blockquote class="citation">{a.texte}</blockquote>
            </div>
            <figcaption class="etiquette">
              <strong>{a.nom}</strong>
              <span>{a.role}</span>
            </figcaption>
          </figure>
        ))
      ) : (
        <div class="temoignage" data-attente>
          <div class="carte-avis">
            <p class="etoiles grandes" aria-hidden="true">
              {cinq.map(() => <span class="pleine">★</span>)}
            </p>
            <p class="citation">Les premiers avis arrivent bientôt.</p>
            <p class="invitation">
              Vous avez travaillé avec moi ? Votre avis compte : il aide les prochaines
              personnes à me faire confiance.
            </p>
          </div>
        </div>
      )}

      <div class="action">
        <a class="btn btn--nuit btn--fleche" href={lienAvis} target="_blank" rel="noopener noreferrer" data-donner-avis>
          Donner mon avis
          <span class="rond-fleche" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="m12 3 2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.3 6.8 19l1-5.8L3.5 9.2l5.9-.8Z" />
            </svg>
          </span>
        </a>
        <p class="note-action" data-note-action>
          Votre avis m'arrive sur WhatsApp. Il est publié ici seulement avec votre accord.
        </p>
      </div>
    </div>
  </div>

  {/* Modèles utilisés par le script pour afficher les avis en direct */}
  <template data-modele-avis>
    <figure class="temoignage" data-avis>
      <div class="carte-avis">
        <span class="etoiles" role="img">
          {cinq.map(() => <span class="vide">★</span>)}
        </span>
        <blockquote class="citation"></blockquote>
      </div>
      <figcaption class="etiquette">
        <strong></strong>
        <span></span>
      </figcaption>
    </figure>
  </template>
  <template data-modele-visage>
    <button type="button" class="visage" data-visage aria-pressed="false"></button>
  </template>

  {enDirect && (
    <dialog class="fiche-avis" aria-labelledby="titre-fiche-avis" data-fiche-avis>
      <button class="fermer" type="button" data-fermer aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>

      <form class="formulaire" data-formulaire-avis>
        <p class="sur-titre">Avis</p>
        <h3 id="titre-fiche-avis">Donner mon avis</h3>
        <p class="explication">
          Votre avis s'affichera sur cette page avec votre nom, une fois relu et validé.
          Les liens ne sont pas acceptés.
        </p>

        <fieldset class="choix-note" data-choix-note>
          <legend>Votre note <span class="requis">(obligatoire)</span></legend>
          {cinq.map((n) => (
            <label>
              <input type="radio" name="note" value={n} required />
              <span aria-hidden="true">★</span>
              <span class="visuellement-cache">{n} sur 5</span>
            </label>
          ))}
        </fieldset>

        <label class="champ">
          <span>Votre nom <span class="requis">(obligatoire)</span></span>
          <input type="text" name="nom" required minlength="2" maxlength="40" autocomplete="name" />
        </label>

        <label class="champ">
          <span>Ce que vous faites</span>
          <input type="text" name="role" maxlength="60" placeholder="Ex. : Étudiante, responsable de club" />
        </label>

        <label class="champ">
          <span>Votre avis <span class="requis">(obligatoire)</span></span>
          <textarea name="texte" rows="4" required minlength="10" maxlength="400" data-texte-avis></textarea>
          <span class="compteur" data-compteur-avis aria-live="polite">0 / 400</span>
        </label>

        {/* Piège à robots : caché aux personnes, les robots le remplissent */}
        <div class="piege" aria-hidden="true">
          <label>Ne pas remplir <input type="text" name="site" tabindex="-1" autocomplete="off" /></label>
        </div>

        <p class="etat" role="status" data-etat-avis></p>
        <p class="secours" data-secours-avis hidden>
          Vous pouvez aussi l'envoyer <a href={lienAvis} target="_blank" rel="noopener noreferrer">sur WhatsApp</a>.
        </p>

        <div class="boutons">
          <button class="btn btn--nuit" type="submit" data-publier-avis>Envoyer mon avis</button>
          <button class="btn annuler" type="button" data-fermer>Annuler</button>
        </div>
      </form>
    </dialog>
  )}
</section>

<script>
  type UnAvis = { nom: string; role: string; note: number; texte: string };

  const section = document.querySelector<HTMLElement>('[data-avis-section]');

  if (section) {
    const zone = section.querySelector<HTMLElement>('[data-avis-zone]')!;
    const action = zone.querySelector<HTMLElement>('.action')!;
    const moyenneBloc = section.querySelector<HTMLElement>('[data-moyenne]')!;
    const visagesBloc = section.querySelector<HTMLElement>('[data-visages]')!;
    const modeleAvis = section.querySelector<HTMLTemplateElement>('[data-modele-avis]')!;
    const modeleVisage = section.querySelector<HTMLTemplateElement>('[data-modele-visage]')!;

    const initiales = (nom: string) =>
      nom.split(/\s+/).filter(Boolean).map((mot) => mot[0]).join('').slice(0, 2).toUpperCase();

    // Un seul avis visible à la fois, choisi avec les ronds
    const montrer = (n: number) => {
      zone.querySelectorAll<HTMLElement>('[data-avis]').forEach((t, i) => { t.hidden = i !== n; });
      visagesBloc.querySelectorAll('[data-visage]').forEach((v, i) => v.setAttribute('aria-pressed', String(i === n)));
    };
    visagesBloc.querySelectorAll('[data-visage]').forEach((v, i) => v.addEventListener('click', () => montrer(i)));
    if (zone.querySelectorAll('[data-avis]').length > 1) montrer(0);

    // Dessine la liste complète des avis (moyenne, ronds, cartes)
    const afficher = (liste: UnAvis[]) => {
      if (!liste.length) return;

      const moyenne = liste.reduce((s, a) => s + a.note, 0) / liste.length;
      const texte = moyenne.toFixed(1).replace('.', ',');
      const etoiles = moyenneBloc.querySelector('.etoiles')!;
      etoiles.setAttribute('aria-label', `Note moyenne : ${texte} sur 5`);
      etoiles.querySelectorAll('span').forEach((e, i) => { e.className = i < Math.round(moyenne) ? 'pleine' : 'vide'; });
      const resume = moyenneBloc.lastElementChild!;
      const fort = document.createElement('strong');
      fort.textContent = `${texte} sur 5`;
      resume.replaceChildren(fort, `, d'après ${liste.length} avis`);
      moyenneBloc.hidden = false;

      zone.querySelectorAll('[data-avis], [data-attente]').forEach((e) => e.remove());
      visagesBloc.replaceChildren();

      liste.forEach((a, i) => {
        const carte = modeleAvis.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const etoilesCarte = carte.querySelector('.etoiles')!;
        etoilesCarte.setAttribute('aria-label', `${a.note} sur 5`);
        etoilesCarte.querySelectorAll('span').forEach((e, n) => { e.className = n < a.note ? 'pleine' : 'vide'; });
        carte.querySelector('.citation')!.textContent = a.texte;
        carte.querySelector('.etiquette strong')!.textContent = a.nom;
        const role = carte.querySelector<HTMLElement>('.etiquette span')!;
        role.textContent = a.role;
        role.hidden = !a.role;
        zone.insertBefore(carte, action);

        if (liste.length > 1) {
          const rond = modeleVisage.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
          rond.textContent = initiales(a.nom);
          rond.setAttribute('aria-label', `Lire l'avis de ${a.nom}`);
          rond.addEventListener('click', () => montrer(i));
          visagesBloc.append(rond);
        }
      });
      visagesBloc.hidden = liste.length < 2;
      montrer(0);
    };

    // ---- Les avis en direct (Firebase) ----
    const projet = section.dataset.projet;
    const cle = section.dataset.cle;
    const fiche = section.querySelector<HTMLDialogElement>('[data-fiche-avis]');

    if (projet && fiche && typeof fiche.showModal === 'function') {
      const fixes: UnAvis[] = JSON.parse(section.dataset.fixes || '[]');
      const base = `https://firestore.googleapis.com/v1/projects/${projet}/databases/(default)/documents`;
      const suffixe = cle ? `key=${encodeURIComponent(cle)}` : '';

      type Champ = { stringValue?: string; integerValue?: string; timestampValue?: string };
      const lire = (champs: Record<string, Champ>): UnAvis => ({
        nom: champs.nom?.stringValue ?? '',
        role: champs.role?.stringValue ?? '',
        note: Number(champs.note?.integerValue ?? 0),
        texte: champs.texte?.stringValue ?? '',
      });

      // Seulement les avis validés par Samuel (les règles Firestore refusent tout le reste).
      // Le tri par date se fait ici, pour ne pas avoir besoin d'un index dans Firebase.
      const charger = async () => {
        try {
          const reponse = await fetch(`${base}:runQuery${suffixe ? '?' + suffixe : ''}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              structuredQuery: {
                from: [{ collectionId: 'avis' }],
                where: { fieldFilter: { field: { fieldPath: 'valide' }, op: 'EQUAL', value: { booleanValue: true } } },
                limit: 50,
              },
            }),
          });
          if (!reponse.ok) return;
          const lignes: { document?: { fields?: Record<string, Champ> } }[] = await reponse.json();
          const enLigne = lignes
            .map((l) => l.document?.fields)
            .filter((f): f is Record<string, Champ> => Boolean(f))
            .sort((a, b) => (b.date?.timestampValue ?? '').localeCompare(a.date?.timestampValue ?? ''))
            .map(lire)
            .filter((a) => a.nom && a.texte && a.note >= 1 && a.note <= 5);
          afficher([...enLigne, ...fixes]);
        } catch {
          // Pas de connexion : on garde ce qui est déjà affiché
        }
      };
      charger();

      // Le bouton ouvre le formulaire au lieu de WhatsApp
      const bouton = section.querySelector<HTMLAnchorElement>('[data-donner-avis]')!;
      section.querySelector('[data-note-action]')!.textContent =
        "Votre avis s'affiche sur cette page avec votre nom, une fois relu et validé.";

      const formulaire = fiche.querySelector<HTMLFormElement>('[data-formulaire-avis]')!;
      const etat = fiche.querySelector<HTMLElement>('[data-etat-avis]')!;
      const secours = fiche.querySelector<HTMLElement>('[data-secours-avis]')!;
      const publier = fiche.querySelector<HTMLButtonElement>('[data-publier-avis]')!;
      const zoneTexte = fiche.querySelector<HTMLTextAreaElement>('[data-texte-avis]')!;
      const compteur = fiche.querySelector<HTMLElement>('[data-compteur-avis]')!;
      const choixNote = fiche.querySelector<HTMLElement>('[data-choix-note]')!;
      let ouvertA = 0;

      bouton.addEventListener('click', (e) => {
        e.preventDefault();
        etat.textContent = '';
        secours.hidden = true;
        fiche.showModal();
        ouvertA = Date.now();
      });

      fiche.addEventListener('click', (e) => {
        const cible = e.target as HTMLElement;
        if (cible === fiche || cible.closest('[data-fermer]')) fiche.close();
      });
      fiche.addEventListener('close', () => bouton.focus());

      // Les étoiles s'allument jusqu'à la note choisie
      choixNote.addEventListener('change', () => {
        const choisie = choixNote.querySelector<HTMLInputElement>('input:checked');
        choixNote.dataset.note = choisie ? choisie.value : '';
      });

      zoneTexte.addEventListener('input', () => {
        compteur.textContent = `${zoneTexte.value.length} / 400`;
      });

      const dejaPublie = () => {
        try { return localStorage.getItem('avis-publie') === '1'; } catch { return false; }
      };

      const idAuHasard = () => {
        const lettres = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        return Array.from(crypto.getRandomValues(new Uint8Array(20)), (n) => lettres[n % lettres.length]).join('');
      };

      formulaire.addEventListener('submit', async (e) => {
        e.preventDefault();
        const donnees = new FormData(formulaire);
        const nom = String(donnees.get('nom') ?? '').trim();
        const role = String(donnees.get('role') ?? '').trim();
        const texte = String(donnees.get('texte') ?? '').trim();
        const note = Number(donnees.get('note'));
        secours.hidden = true;

        // Robot : on fait comme si c'était envoyé, sans rien envoyer
        if (donnees.get('site') || Date.now() - ouvertA < 3000) {
          etat.textContent = 'Merci ! Votre avis sera affiché après validation.';
          return;
        }
        if (dejaPublie()) {
          etat.textContent = 'Merci, vous avez déjà donné votre avis depuis ce téléphone.';
          return;
        }
        const lien = /(https?:\/\/|www\.)/i;
        if (lien.test(nom) || lien.test(role) || lien.test(texte)) {
          etat.textContent = 'Les liens ne sont pas acceptés. Retirez-les puis réessayez.';
          return;
        }
        if (nom.length < 2 || texte.length < 10 || !(note >= 1 && note <= 5)) {
          etat.textContent = 'Il manque votre note, votre nom ou votre avis (10 lettres au moins).';
          return;
        }

        publier.disabled = true;
        etat.textContent = 'Envoi en cours…';
        const id = idAuHasard();
        try {
          const reponse = await fetch(`${base}:commit${suffixe ? '?' + suffixe : ''}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              writes: [{
                update: {
                  name: `projects/${projet}/databases/(default)/documents/avis/${id}`,
                  fields: {
                    nom: { stringValue: nom },
                    role: { stringValue: role },
                    note: { integerValue: String(note) },
                    texte: { stringValue: texte },
                    valide: { booleanValue: false },
                  },
                },
                currentDocument: { exists: false },
                updateTransforms: [{ fieldPath: 'date', setToServerValue: 'REQUEST_TIME' }],
              }],
            }),
          });
          if (!reponse.ok) throw new Error(String(reponse.status));
          try { localStorage.setItem('avis-publie', '1'); } catch { /* rien */ }
          formulaire.reset();
          choixNote.dataset.note = '';
          compteur.textContent = '0 / 400';
          etat.textContent = 'Merci ! Votre avis sera affiché après validation.';
          setTimeout(() => fiche.close(), 1600);
        } catch {
          etat.textContent = "Votre avis n'a pas pu être envoyé. Vérifiez votre connexion et réessayez.";
          secours.hidden = false;
        } finally {
          publier.disabled = false;
        }
      });
    }
  }
</script>

<style>
  /* Place en bas pour le bloc rouge « Contact » qui vient se poser par-dessus */
  .avis {
    padding-bottom: 104px;
  }

  @media (min-width: 768px) {
    .avis {
      padding-bottom: 160px;
    }
  }

  .grille {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 900px) {
    .grille {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: center;
    }
  }

  .guillemet {
    display: block;
    height: 0.62em;
    margin-bottom: 16px;
    color: var(--rouge);
    font-family: var(--police-serif);
    font-size: 7rem;
    line-height: 0.8;
  }

  .moyenne {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 4px 0 0;
    font-size: 1.05rem;
  }

  .moyenne[hidden] {
    display: none;
  }

  .moyenne strong {
    color: var(--texte);
  }

  .etoiles {
    display: inline-flex;
    gap: 2px;
    font-size: 1.25rem;
    line-height: 1;
  }

  /* Un or plus foncé, assez visible sur le fond clair */
  .pleine {
    color: #B8860B;
  }

  .vide {
    color: rgba(18, 20, 28, 0.18);
  }

  .visages {
    display: none;
  }

  :global(.js) .visages {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  :global(.js) .visages[hidden] {
    display: none;
  }

  .visage {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 3px solid transparent;
    border-radius: 50%;
    background: var(--nuit-2);
    color: #fff;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .visage[aria-pressed="true"] {
    border-color: var(--rouge);
    opacity: 1;
  }

  .visage:active {
    background: var(--or);
    color: var(--nuit);
  }

  /* La carte penchée et son étiquette */

  .temoignage {
    margin: 0;
  }

  .temoignage[hidden] {
    display: none;
  }

  .carte-avis {
    padding: 28px 24px;
    border: 1px solid rgba(18, 20, 28, 0.06);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 30px 60px -28px rgba(18, 20, 28, 0.35);
    transform: rotate(-1.5deg);
  }

  @media (min-width: 600px) {
    .carte-avis {
      padding: 36px 40px;
    }
  }

  .citation {
    margin: 12px 0 0;
    color: var(--texte);
    font-family: var(--police-serif);
    font-size: clamp(1.5rem, 4.6vw, 2.1rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
    white-space: pre-line;
  }

  .grandes {
    margin: 0;
    font-size: 1.7rem;
    letter-spacing: 4px;
  }

  .invitation {
    margin: 14px 0 0;
    max-width: 480px;
  }

  .etiquette {
    display: flex;
    flex-direction: column;
    width: fit-content;
    max-width: 90%;
    margin: -12px 8px 0 auto;
    padding: 12px 20px;
    border-radius: 16px;
    background: var(--nuit);
    color: #fff;
    transform: rotate(2deg);
    position: relative;
    overflow-wrap: anywhere;
  }

  .etiquette span {
    color: var(--texte-clair);
    font-family: var(--police-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .etiquette span[hidden] {
    display: none;
  }

  .action {
    margin-top: 36px;
  }

  .note-action {
    margin: 12px 0 0;
    font-size: 0.88rem;
  }

  /* Le formulaire « Donner mon avis » */

  .fiche-avis {
    width: min(520px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    overflow: auto;
    border: 0;
    border-radius: 24px;
    background: var(--creme);
    color: var(--gris);
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45);
  }

  .fiche-avis[open] {
    animation: entree-avis 0.5s var(--courbe);
  }

  @keyframes entree-avis {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }

  .fiche-avis::backdrop {
    background: rgba(18, 20, 28, 0.75);
  }

  .fermer {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgba(18, 20, 28, 0.08);
