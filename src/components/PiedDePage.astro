---
// Bas de page (fond bordeaux) : mes contacts en ronds, un grand rond doré
// pour m'écrire, mon nom en très grand, le menu et le copyright.
import { contact } from '../data/contact.js';

const annee = 2026;
const liens = [
  { href: '#projets', texte: 'Projets' },
  { href: '#qui-suis-je', texte: 'Qui suis-je ?' },
  { href: '#competences', texte: 'Compétences' },
  { href: '#avis', texte: 'Avis' },
  { href: '#contact', texte: 'Contact' },
];
---

<footer class="pied">
  <div class="conteneur">
    <div class="haut-pied">
      <ul class="reseaux" aria-label="Me contacter">
        <li>
          <a href={contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3.2 3.2Z" />
              <path d="M9.2 8.6c.2-.4.6-.5.9-.3l.9 1.6c.1.3 0 .6-.2.8l-.5.5a6 6 0 0 0 2.6 2.6l.5-.5c.2-.2.5-.3.8-.2l1.6.9c.3.2.4.6.2.9-.5 1-1.6 1.4-2.6 1a9 9 0 0 1-5.2-5.2c-.4-1 0-2 1-2.1Z" />
            </svg>
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`} aria-label="E-mail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m4 7 8 6 8-6" />
            </svg>
          </a>
        </li>
        <li>
          <a href={contact.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        </li>
        <li>
          <a href="#accueil" aria-label="Revenir en haut">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 19V5M6 11l6-6 6 6" />
            </svg>
          </a>
        </li>
      </ul>

      <a class="cercle" href={contact.whatsapp} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" />
        </svg>
        <span>Écrire sur WhatsApp</span>
      </a>
    </div>

    <p class="geant">
      <span class="rond" aria-hidden="true">SM</span>
      <span>Samuel Mukadi</span>
    </p>
    <p class="metier">Chef de projet digital &amp; <span class="italique">orchestrateur d'IA</span></p>

    <div class="bas">
      <p>© {annee} Samuel Mukadi · Fait en RDC</p>
      <nav aria-label="Menu du bas de page">
        <ul class="liste">
          {liens.map((lien) => (
            <li><a href={lien.href}>{lien.texte}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .pied {
    padding-top: 64px;
    background:
      radial-gradient(50% 50% at 100% 0%, rgba(198, 40, 40, 0.35) 0, transparent 70%),
      var(--bordeaux);
    color: rgba(255, 255, 255, 0.78);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .pied {
      padding-top: 96px;
    }
  }

  p {
    margin: 0;
  }

  .haut-pied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .reseaux {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reseaux a {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    color: #fff;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .reseaux a:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .reseaux svg {
    width: 20px;
    height: 20px;
  }

  /* Le grand rond doré */
  .cercle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 148px;
    height: 148px;
    padding: 16px;
    border-radius: 50%;
    background: var(--or);
    color: var(--nuit);
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.5);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.4s var(--courbe), background-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .cercle {
      width: 176px;
      height: 176px;
      font-size: 1.05rem;
    }
  }

  .cercle:hover {
    transform: rotate(-8deg) scale(1.04);
  }

  .cercle svg {
    width: 26px;
    height: 26px;
  }

  /* Mon nom en très grand */
  .geant {
    display: flex;
    align-items: center;
    gap: 0.25em;
    margin-top: 56px;
    color: var(--creme);
    font-size: clamp(2.4rem, 10.5vw, 8rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }

  .rond {
    display: none;
  }

  @media (min-width: 768px) {
    .rond {
      display: grid;
      place-items: center;
      width: 2.1em;
      height: 2.1em;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--or);
      color: var(--nuit);
      font-size: 0.4em;
      letter-spacing: 0;
    }
  }

  .metier {
    margin-top: 14px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.05rem;
  }

  .metier .italique {
    color: var(--or);
  }

  .bas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: 40px;
    padding: 14px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--police-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .liste {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .liste a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
  }

  .liste a:hover {
    color: var(--or);
  }

  /* Effet de clic doré */
  .reseaux a:active,
  .liste a:active {
    border-color: var(--or);
    background: var(--or);
    color: var(--nuit);
  }

  .cercle:active {
    background: #fff;
    transform: scale(0.96);
  }

  .pied :focus-visible {
    outline-color: var(--or);
  }
</style>
