---
// La page d'accueil du portfolio : toutes les sections, l'une sous l'autre.
// Les projets sont dans le haut de page (le paquet de cartes, à côté du titre).
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Accueil from '../components/Accueil.astro';
import Bandeau from '../components/Bandeau.astro';
import APropos from '../components/APropos.astro';
import Competences from '../components/Competences.astro';
import Avis from '../components/Avis.astro';
import Contact from '../components/Contact.astro';
import PiedDePage from '../components/PiedDePage.astro';
import BoutonWhatsApp from '../components/BoutonWhatsApp.astro';
---

<Base
  titre="Samuel Mukadi — Chef de projet digital & orchestrateur d'IA"
  description="Je conçois des produits numériques pour la RDC et j'orchestre une équipe d'IA pour les construire."
>
  <Entete />
  <main id="contenu" tabindex="-1">
    <Accueil />
    <Bandeau />
    <APropos />
    <Competences />
    <Avis />
    <Contact />
  </main>
  <PiedDePage />
  <BoutonWhatsApp />
</Base>
